<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Activity Log</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header', { isAdmin: isAdmin }) %>
  <div class="content">
    <h1>Activity Log</h1>
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Action</th>
          <th>Timestamp</th>
        </tr>
      </thead>
      <tbody>
        <% activities.forEach(activity => { %>
          <tr>
            <td><%= activity.user.username %></td>
            <td><%= activity.action %></td>
            <td><%= activity.timestamp.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %>" class="btn-pagination">Previous</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>" class="btn-pagination <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="?page=<%= currentPage + 1 %>" class="btn-pagination">Next</a>
      <% } %>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
