<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header', { isAdmin: isAdmin }) %>
  <div class="content">
    <h1>Admin Dashboard</h1>
    <h2>Users</h2>
    <table>
      <thead>
        <tr>
          <th>Username</th>
          <th>Role</th>
          <th>Change Role</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.username %></td>
            <td><%= user.role.name %></td>
            <td>
              <form action="/admin/update-role" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="userId" value="<%= user._id %>">
                <select name="roleId">
                  <% roles.forEach(role => { %>
                    <option value="<%= role._id %>" <%= user.role._id.equals(role._id) ? 'selected' : '' %>><%= role.name %></option>
                  <% }) %>
                </select>
                <button type="submit">Update</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
