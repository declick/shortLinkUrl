<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function confirmDelete(userId) {
      if (confirm('Are you sure you want to delete this user?')) {
        const form = document.getElementById('delete-form-' + userId);
        form.submit();
      }
    }
  </script>
</head>
<body>
  <%- include('partials/header', { isAdmin: isAdmin }) %>
  <div class="content">
    <h1>Admin Dashboard</h1>
    <h2>Users</h2>
    <table>
      <thead>
        <tr>
          <th>Username</th>
          <th>Role</th>
          <th>Change Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr id="user-<%= user._id %>">
            <td><%= user.username %></td>
            <td><%= user.role.name %></td>
            <td>
              <form action="/admin/update-role" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="userId" value="<%= user._id %>">
                <select name="roleId">
                  <% roles.forEach(role => { %>
                    <option value="<%= role._id %>" <%= user.role._id.equals(role._id) ? 'selected' : '' %>><%= role.name %></option>
                  <% }) %>
                </select>
                <button type="submit">Update</button>
              </form>
            </td>
            <td>
              <form id="delete-form-<%= user._id %>" action="/admin/delete-user" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="userId" value="<%= user._id %>">
                <button type="button" onclick="confirmDelete('<%= user._id %>')" class="btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %>" class="btn-pagination">Previous</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>" class="btn-pagination <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="?page=<%= currentPage + 1 %>" class="btn-pagination">Next</a>
      <% } %>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
