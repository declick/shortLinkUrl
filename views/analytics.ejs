<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Analytics for <%= url.shortUrl %></title>
  <link rel="stylesheet" href="/style.css" type="text/css">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    const updateStatistics = (stats) => {
      const clicksCountElement = document.getElementById('clicksCount');
      const countryListElement = document.getElementById('countryList');
      const dailyClicksElement = document.getElementById('averageDailyClicks');
      const weeklyClicksElement = document.getElementById('averageWeeklyClicks');
      const monthlyClicksElement = document.getElementById('averageMonthlyClicks');

      clicksCountElement.innerText = stats.totalClicks;
      dailyClicksElement.innerText = stats.averageDailyClicks || '0.00';
      weeklyClicksElement.innerText = stats.averageWeeklyClicks || '0.00';
      monthlyClicksElement.innerText = stats.averageMonthlyClicks || '0.00';

      countryListElement.innerHTML = '';

      for (const country in stats.countryPercentages) {
        const li = document.createElement('li');
        li.innerHTML = `
          <img src="/flags/${country.toLowerCase()}.png" alt="${country} flag" style="width: 20px; height: 15px;">
          ${country}: ${stats.countryPercentages[country]}%
        `;
        countryListElement.appendChild(li);
      }
    };

    socket.on('clickUpdate', function(data) {
      if (data.shortUrl === '<%= url.shortUrl %>') {
        updateStatistics(data.stats);
      }
    });
  </script>
</head>
<body>
  <%- include('partials/header', { title: 'Analytics', user: user, isAdmin: isAdmin }) %>
  <div class="content">
    <h1>Analytics for <%= url.shortUrl %></h1>
    <p>Original URL: <a href="<%= url.originalUrl %>"><%= url.originalUrl %></a></p>
    <p>Date Created: <%= new Date(url.createdAt).toLocaleString() %></p>

    <h2>Click Statistics</h2>
    <p><strong>Clicks:</strong> <span id="clicksCount"><%= clicksCount %></span></p>

    <h2>Average Clicks</h2>
    <div class="analytics">
      <div class="analytics-box">Average Daily: <span id="averageDailyClicks"><%= averageDailyClicks %></span></div>
      <div class="analytics-box">Average Weekly: <span id="averageWeeklyClicks"><%= averageWeeklyClicks %></span></div>
      <div class="analytics-box">Average Monthly: <span id="averageMonthlyClicks"><%= averageMonthlyClicks %></span></div>
    </div>

    <h2>Click Distribution by Country</h2>
    <ul id="countryList">
      <% for (const country in countryPercentages) { %>
        <li>
          <img src="/flags/<%= country.toLowerCase() %>.png" alt="<%= country %> flag" style="width: 20px; height: 15px;">
          <%= country %>: <%= countryPercentages[country] %>%
        </li>
      <% } %>
    </ul>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
