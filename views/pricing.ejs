<!-- views/pricing.ejs -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pricing</title>
  <link rel="stylesheet" href="/style.css" type="text/css">
</head>
<body>
    <%- include('partials/header', { title: 'Pricing', user: user, isAdmin: isAdmin }) %>
    <div class="content">
      <h1>Pricing Plans</h1>
      <div class="pricing-table">
        <div class="pricing-plan">
          <h2>Free Plan</h2>
          <p>Perfect for individuals.</p>
          <ul>
            <li>10 Shortened URLs per month</li>
            <li>Basic Analytics</li>
            <li>Email Support</li>
          </ul>
          <a href="/signup" class="btn-primary">Sign Up for Free</a>
        </div>
        <div class="pricing-plan">
          <h2>Monthly Plan</h2>
          <p>Ideal for small businesses.</p>
          <ul>
            <li>Unlimited Shortened URLs</li>
            <li>Advanced Analytics</li>
            <li>Priority Email Support</li>
          </ul>
          <a href="#" class="btn-primary btn-disabled">$10/month</a>
        </div>
        <div class="pricing-plan">
          <h2>Annual Plan</h2>
          <p>Best for large organizations.</p>
          <ul>
            <li>Unlimited Shortened URLs</li>
            <li>Advanced Analytics</li>
            <li>Priority Email Support</li>
            <li>Dedicated Account Manager</li>
          </ul>
          <a href="#" class="btn-primary btn-disabled">$100/year</a>
        </div>
      </div>
    </div>
    <%- include('partials/footer') %>
</body>
</html>
