<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/style.css" type="text/css">
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
  <%- include('partials/header', { title: 'Dashboard', user: user,isAdmin: isAdmin }) %>
  <div class="content">
    <h1>Dashboard</h1>
    <p>Welcome, <%= user.username %>!</p>
    <h2>Your Short URLs</h2>
    <ul id="url-list">
      <% urls.forEach(url => { %>
        <li id="url-<%= url.shortUrl %>">
          <a href="<%= req.protocol %>://<%= req.get('host') %>/<%= url.shortUrl %>">
            <%= req.protocol %>://<%= req.get('host') %>/<%= url.shortUrl %>
          </a> - <%= url.originalUrl %>
          <ul>
            <li><strong>Date Created:</strong> <%= new Date(url.createdAt).toLocaleString() %></li>
            <li><a class="btn-primary" href="/analytics/<%= url.shortUrl %>">View Analytics</a></li>
            <li><button class="btn-danger" onclick="confirmDelete('<%= url.shortUrl %>')">Delete</button></li>
          </ul>
        </li>
      <% }) %>
    </ul>
    
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %>" class="btn-pagination">Previous</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>" class="btn-pagination <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="?page=<%= currentPage + 1 %>" class="btn-pagination">Next</a>
      <% } %>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const socket = io();

    socket.on('urlDeleted', function(data) {
      const urlElement = document.getElementById('url-' + data.shortUrl);
      if (urlElement) {
        urlElement.remove();
      }
    });

    function confirmDelete(shortUrl) {
      Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, delete it!'
      }).then((result) => {
        if (result.isConfirmed) {
          deleteUrl(shortUrl);
        }
      });
    }

    function deleteUrl(shortUrl) {
      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

      fetch('/dashboard/' + shortUrl, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        }
      }).then(response => {
        if (response.ok) {
          socket.emit('urlDeleted', { shortUrl: shortUrl });
          Swal.fire(
            'Deleted!',
            'Your short URL has been deleted.',
            'success'
          ).then(() => {
            // Reload the page after deletion
            const urlList = document.getElementById('url-list');
            if (urlList.children.length === 0) {
              // If there are no more URLs on the current page, reload to the previous page or the first page
              const currentPage = parseInt('<%= currentPage %>', 10);
              if (currentPage > 1) {
                window.location.href = '?page=' + (currentPage - 1);
              } else {
                window.location.href = '?page=1';
              }
            } else {
              window.location.reload();
            }
          });
        } else {
          Swal.fire(
            'Error!',
            'There was an error deleting your short URL.',
            'error'
          );
        }
      });
    }
  </script>
</body>
</html>
