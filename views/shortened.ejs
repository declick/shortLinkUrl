<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shortened URL</title>
  <link rel="stylesheet" href="/style.css" type="text/css">
</head>
<body>
  <%- include('partials/header', { title: 'Shortened URL', user: user, isAdmin: isAdmin }) %>
  <div class="content">
    <h1>Shortened URL</h1>
    <p>Your shortened URL is: <a href="/<%= shortUrl %>"><%= req.protocol %>://<%= req.get('host') %>/<%= shortUrl %></a></p>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
